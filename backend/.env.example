# Copy to .env and adjust. docker-compose provides a matching Postgres.
DATABASE_URL="postgresql://pub:pub@localhost:5432/pub_system?schema=public"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# Business config (defaults; also editable in Settings)
DEFAULT_TAX_RATE="0.16"
LOYALTY_POINTS_PER_UNIT="1"
SAFETY_STOCK_DAYS="3"
